{
  "expo": {
    "name": "Devki",
    "slug": "Devki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/devki-logo.png",
    "scheme": "devki",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5b7b40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adityasaini823.Devki"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/devki-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/devki-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5b7b40",
          "dark": {
            "backgroundColor": "#5b7b40"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50541dc8-d1c4-4be0-9fee-4ebb2f859cac"
      }
    }
  }
}
